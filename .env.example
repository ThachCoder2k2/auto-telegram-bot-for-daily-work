TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BRIEFING_MODE=dev_ielts
# Values with spaces or commas are quoted: some .env parsers stop at the
# first unquoted space and silently drop every line after it.
BRIEFING_LOCATION="Hanoi, Vietnam"
CURRENT_PROJECT_FOCUS="Godot horror-platformer"
# Seeds the task list only on first run; after that state/briefing_state.json
# is authoritative and /done, /task and /drop drive it.
PENDING_TASKS="Prototype one horror-platformer mechanic in Godot"
BRIEFING_STATE_PATH=state/briefing_state.json
ENABLED_CATEGORIES=web_tech,hardware,gaming,governance
NEWS_ITEMS_PER_CATEGORY=5
ENABLED_COLLECTORS=hacker_news,rss,tavily,world_bank
ENABLED_RSS_FEEDS="OpenAI News,Hugging Face Blog"
ENABLED_SECTIONS=tech,ai,stats,watchlist
HACKER_NEWS_LIMIT=18
RSS_LIMIT_PER_FEED=8
TECH_ITEM_LIMIT=3
AI_ITEM_LIMIT=3
WATCHLIST_ITEM_LIMIT=3
FRED_API_KEY=
TAVILY_API_KEY=
TAVILY_ENABLED=true
TAVILY_MAX_RESULTS=4
TAVILY_SEARCH_DEPTH=basic
TAVILY_TOPIC=news
TAVILY_TIME_RANGE=day
OPENAI_API_KEY=
OPENAI_ENABLED=false
OPENAI_MODEL=gpt-5.4-mini
BOT_PERSONA_ENABLED=true
BOT_PERSONA_ROTATION=daily
BOT_PERSONA_POOL=succubus,milf_teacher,soft_girlfriend,rot_maiden,final_boss_queen
BOT_PERSONA_FORCE=
BOT_PERSONA_SPICE_LEVEL=2
BOT_PERSONA_SAFE_MODE=true
BOT_PERSONA_IMAGE_ENABLED=true
BOT_PERSONA_IMAGE_DIR=assets/personas
BOT_PERSONA_IMAGE_URLS_PATH=assets/personas/image_urls.json
DIGEST_LANGUAGE=en
TIMEZONE=Asia/Ho_Chi_Minh

# --- AI provider (openai | gemini) ---
AI_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Two-way command loop (/done, /task, /skip, /quiz, /status, /digest) ---
# The poller only accepts messages from TELEGRAM_CHAT_ID.
COMMANDS_ENABLED=true
COMMAND_POLL_SECONDS=30

# --- Ranking memory ---
# Days a story stays suppressed after being sent.
REPEAT_WINDOW_DAYS=5

# --- Weekly recap (6 = Sunday) ---
WEEKLY_RECAP_ENABLED=true
WEEKLY_RECAP_WEEKDAY=6

# --- IELTS spaced repetition ---
VOCAB_REVIEW_ENABLED=true
VOCAB_REVIEW_LIMIT=3

# --- Per-item "why it matters" (fetches the article, then asks the model) ---
ITEM_TAKES_ENABLED=true
ITEM_TAKES_LIMIT=3

# --- Observability ---
LOG_LEVEL=INFO

# --- Docker scheduler (docker/scheduler.py) ---
DAILY_SEND_HOUR=8
DAILY_SEND_MINUTE=0
RUN_ON_START=false
SEND_RETRIES=3
SEND_RETRY_BACKOFF=60

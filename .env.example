TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BRIEFING_MODE=dev_ielts
# Values with spaces or commas are quoted: some .env parsers stop at the
# first unquoted space and silently drop every line after it.
BRIEFING_LOCATION="Hanoi, Vietnam"
CURRENT_PROJECT_FOCUS="Godot horror-platformer"
# Seeds the task list only on first run; after that state/briefing_state.json
# is authoritative and /done, /task and /drop drive it.
PENDING_TASKS="Prototype one horror-platformer mechanic in Godot"
BRIEFING_STATE_PATH=state/briefing_state.json
ENABLED_CATEGORIES=web_tech,hardware,gaming,governance
NEWS_ITEMS_PER_CATEGORY=5
ENABLED_COLLECTORS=hacker_news,rss,tavily,world_bank
ENABLED_RSS_FEEDS="OpenAI News,Hugging Face Blog"
ENABLED_SECTIONS=tech,ai,stats,watchlist
HACKER_NEWS_LIMIT=18
RSS_LIMIT_PER_FEED=8
TECH_ITEM_LIMIT=3
AI_ITEM_LIMIT=3
WATCHLIST_ITEM_LIMIT=3
FRED_API_KEY=
TAVILY_API_KEY=
TAVILY_ENABLED=true
TAVILY_MAX_RESULTS=4
TAVILY_SEARCH_DEPTH=basic
TAVILY_TOPIC=news
TAVILY_TIME_RANGE=day
OPENAI_API_KEY=
OPENAI_ENABLED=false
OPENAI_MODEL=gpt-5.4-mini
BOT_PERSONA_ENABLED=true
BOT_PERSONA_ROTATION=daily
BOT_PERSONA_POOL=succubus,milf_teacher,soft_girlfriend,rot_maiden,final_boss_queen
BOT_PERSONA_FORCE=
BOT_PERSONA_SPICE_LEVEL=2
BOT_PERSONA_SAFE_MODE=true
BOT_PERSONA_IMAGE_ENABLED=true
BOT_PERSONA_IMAGE_DIR=assets/personas
BOT_PERSONA_IMAGE_URLS_PATH=assets/personas/image_urls.json
DIGEST_LANGUAGE=en
TIMEZONE=Asia/Ho_Chi_Minh

# --- AI provider (openai | gemini) ---
AI_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Two-way command loop (/done, /task, /skip, /quiz, /status, /digest) ---
# The poller only accepts messages from TELEGRAM_CHAT_ID.
COMMANDS_ENABLED=true
COMMAND_POLL_SECONDS=30

# --- Ranking memory ---
# Days a story stays suppressed after being sent.
REPEAT_WINDOW_DAYS=5

# --- Weekly recap (6 = Sunday) ---
WEEKLY_RECAP_ENABLED=true
WEEKLY_RECAP_WEEKDAY=6

# --- IELTS spaced repetition ---
VOCAB_REVIEW_ENABLED=true
VOCAB_REVIEW_LIMIT=3

# --- Per-item "why it matters" (fetches the article, then asks the model) ---
ITEM_TAKES_ENABLED=true
ITEM_TAKES_LIMIT=3

# --- Notion tasks + reminder engine ---
# Token: Settings -> Nhà phát triển (Developers) -> Token mới.
# Database id: the 32 hex chars in the database URL, before the "?".
# The database must be shared with the token (database ... -> Connections),
# otherwise every call returns 404 even with a valid token.
NOTION_ENABLED=false
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_TASK_LIMIT=5
# Set false to make the integration strictly read-only.
NOTION_WRITE_ENABLED=true
# Drives reminders from the board's own Reminder / Reminder Frequency /
# Last Reminded columns.
NOTION_REMINDERS_ENABLED=true
# Nudges are held outside these hours; an overnight one fires at the open.
NOTION_QUIET_START=8
NOTION_QUIET_END=22
# Dùng khi Reminder được tick nhưng Reminder Frequency để trống.
NOTION_DEFAULT_FREQUENCY=Every day
NOTION_REMINDER_CHECK_SECONDS=3600
# Only needed when column auto-detection guesses wrong.
NOTION_PROP_STATUS=
NOTION_PROP_PRIORITY=
NOTION_PROP_LAST_REMINDED=

# --- Observability ---
LOG_LEVEL=INFO

# --- Docker scheduler (docker/scheduler.py) ---
DAILY_SEND_HOUR=8
DAILY_SEND_MINUTE=0
RUN_ON_START=false
SEND_RETRIES=3
SEND_RETRY_BACKOFF=60

# --- Notion dated notes / meetings (a second board with a Date column) ---
# Surfaced once a day in the brief, and pinged separately only as the date
# nears — nothing here rots by being ignored, the date simply arrives.
NOTION_NOTES_ENABLED=false
NOTION_NOTES_DATABASE_ID=
NOTION_NOTES_LOOKAHEAD_DAYS=14
NOTION_NOTES_ALERT_DAYS=3

# Let the AI backend write nudges in the persona voice (falls back to
# canned lines when the model is off or rate-limited).
NOTION_AI_VOICE_ENABLED=true
